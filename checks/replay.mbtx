----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----
async fn main {
  let args = @env.args()
  let moon = if args.length() > 1 { args[1] } else { "moon" }
  let target = if args.length() > 2 { args[2] } else { "wasm" }
  let dir = @fs.tmpdir(prefix="metricstitch-")
  defer {
    for file in @fs.readdir(dir[:]) { @fs.remove((dir + "/" + file)[:]) }
    @fs.rmdir(dir[:])
  }
  let prefix = ["run","--target",target,"cli","--"]
  let original = @shell.Cmd(moon,prefix + ["examples/upstream-metrics.json"]).output()
  if original.exit_code() != 2 || !original.stdout().is_empty() { fail("unsupported official example was silently converted") }
  let source = @json.parse(@fs.read_file("examples/upstream-metrics.json").text())
  guard source is {"resourceMetrics":Array([Object(resource)]),..} && resource.get("scopeMetrics") is Some(Array([Object(scope)])) && scope.get("metrics") is Some(Array([Object(metric),..])) && metric.get("sum") is Some(Object(sum)) && sum.get("dataPoints") is Some(Array([Object(point)])) else { fail("upstream fixture shape changed") }
  ignore(point.remove("asDouble"))
  point["asInt"] = Json("5")
  point["startTimeUnixNano"] = Json("1544712660000000000")
  scope["metrics"] = Json::array([Json::object(metric)])
  let input = dir + "/input.json"
  let checkpoint = dir + "/checkpoint.json"
  let receipt = dir + "/first receipt.json"
  let first_request = @json.parse(source.stringify())
  @fs.write_file(input[:],source.stringify())
  let first = @shell.Cmd(moon,prefix + [input]).output()
  if first.exit_code() != 0 { fail(first.stderr()) }
  let checked = @shell.Cmd(moon,prefix + ["check",input]).output()
  if checked.exit_code() != 0 || !checked.stdout().contains("\"valid\":true") { fail("read-only check rejected valid input") }
  let installed = @shell.Cmd(moon,prefix + ["apply-to",input,receipt]).output()
  if installed.exit_code() != 0 || !installed.stdout().is_empty() || @fs.read_file(receipt[:]).text() != first.stdout() { fail("receipt publication failed") }
  let overwritten = @shell.Cmd(moon,prefix + ["apply-to",input,receipt]).output()
  if overwritten.exit_code() != 2 || @fs.read_file(receipt[:]).text() != first.stdout() { fail("existing receipt was overwritten") }
  let original_input = @fs.read_file(input[:]).text()
  let input_alias = @shell.Cmd(moon,prefix + ["apply-to",input,input]).output()
  if input_alias.exit_code() != 2 || @fs.read_file(input[:]).text() != original_input { fail("input file was overwritten") }
  guard @json.parse(first.stdout()) is {"checkpoint":saved,"request":result,..} else { fail("invalid receipt") }
  if !result.stringify().contains("\"aggregationTemporality\":2") { fail("not cumulative") }
  @fs.write_file(checkpoint[:],saved.stringify())
  let retry = @shell.Cmd(moon,prefix + [input,checkpoint]).output()
  if retry.exit_code() != 0 || !retry.stdout().contains("\"duplicates\":1") { fail("retry duplicated the count") }
  point["startTimeUnixNano"] = Json("1544712660300000000")
  point["timeUnixNano"] = Json("1544712660600000000")
  point["asInt"] = Json("7")
  @fs.write_file(input[:],source.stringify())
  let second = @shell.Cmd(moon,prefix + [input,checkpoint]).output()
  if second.exit_code() != 0 || !second.stdout().contains("\"asInt\":\"12\"") { fail("restored sum is wrong: " + second.stderr()) }
  let second_request = @json.parse(source.stringify())
  let sequence_input = dir + "/sequence.json"
  let sequence_output = dir + "/sequence-receipt.json"
  let sequence : Json = {"requests":[first_request,first_request,second_request]}
  @fs.write_file(sequence_input[:],sequence.stringify())
  @shell.Cmd(moon,prefix + ["replay-to",sequence_input,sequence_output]).run()
  guard @json.parse(@fs.read_file(sequence_output[:]).text()) is {"checkpoint":sequence_state,"duplicates":Number(1.0,..),..} && @json.parse(second.stdout()) is {"checkpoint":second_state,..} else { fail("sequence receipt") }
  if sequence_state != second_state { fail("sequence and sequential states differ") }
  let sequence_resume = dir + "/sequence-resume.json"
  @shell.Cmd(moon,prefix + ["replay-to",sequence_input,sequence_resume,receipt]).run()
  guard @json.parse(@fs.read_file(sequence_resume[:]).text()) is {"checkpoint":resumed_state,..} else { fail("sequence resume receipt") }
  if resumed_state != second_state { fail("sequence resume lost state") }
  @fs.write_file(sequence_input[:],"{\"requests\":[" + first_request.stringify() + ",{\"unknown\":true}]}")
  let failed_sequence = dir + "/failed-sequence.json"
  let late_failure = @shell.Cmd(moon,prefix + ["replay-to",sequence_input,failed_sequence]).output()
  if late_failure.exit_code() != 2 || !late_failure.stderr().contains("/requests/1") || @fs.exists(failed_sequence[:]) { fail("late sequence refusal failed: " + late_failure.exit_code().to_string() + " " + late_failure.stderr()) }
  let next_receipt = dir + "/next receipt.json"
  let resumed_file = @shell.Cmd(moon,prefix + ["apply-to",input,next_receipt,receipt]).output()
  if resumed_file.exit_code() != 0 || @fs.read_file(next_receipt[:]).text() != second.stdout() { fail("whole-receipt resume failed") }
  ignore(point.remove("asInt"))
  point["asDouble"] = Json(1.25)
  @fs.write_file(input[:],source.stringify())
  let floating = @shell.Cmd(moon,prefix + [input]).output()
  if floating.exit_code() != 0 || !floating.stdout().contains("\"asDouble\":1.25") { fail("Double point did not convert") }
  let switched = @shell.Cmd(moon,prefix + [input,checkpoint]).output()
  if switched.exit_code() != 2 || !switched.stdout().is_empty() { fail("numeric kind switch was accepted") }
  @fs.write_file(input[:],"{\"resourceMetrics\":[],\"unknown\":true}")
  let bad = @shell.Cmd(moon,prefix + [input,checkpoint]).output()
  let checked_bad = @shell.Cmd(moon,prefix + ["check",input,checkpoint]).output()
  if checked_bad.exit_code() != 2 || !checked_bad.stdout().contains("\"valid\":false") { fail("read-only gate accepted invalid input") }
  if bad.exit_code() != 2 || !bad.stdout().is_empty() || @fs.read_file(checkpoint[:]).text() != saved.stringify() { fail("rejected input damaged a checkpoint") }
  let refused_file = dir + "/refused.json"
  let refused = @shell.Cmd(moon,prefix + ["apply-to",input,refused_file,receipt]).output()
  if refused.exit_code() != 2 || @fs.exists(refused_file[:]) { fail("invalid batch published a receipt") }
  @fs.write_file(input[:],"{}")
  let malformed_receipt = @shell.Cmd(moon,prefix + ["apply-to","examples/upstream-metrics.json",refused_file,input]).output()
  if malformed_receipt.exit_code() != 2 || malformed_receipt.stderr().is_empty() || @fs.exists(refused_file[:]) { fail("malformed resume receipt was accepted") }
  for name in @fs.readdir(dir[:]) {
    if name.has_suffix(".pending") { fail("failed publication left a temporary receipt") }
  }
  let histogram_source = @json.parse(@fs.read_file("examples/upstream-metrics.json").text())
  guard histogram_source is {"resourceMetrics":[{"scopeMetrics":[Object(hscope)],..}],..} && hscope.get("metrics") is Some(Array([_,_,Object(hmetric),..])) && hmetric.get("histogram") is Some({"dataPoints":[Object(hpoint)],..}) else { fail("missing upstream histogram") }
  hscope["metrics"] = Json::array([Json::object(hmetric)])
  hpoint["startTimeUnixNano"] = Json("1544712660000000000")
  @fs.write_file(input[:],histogram_source.stringify())
  let hist_receipt = dir + "/histogram.json"
  @shell.Cmd(moon,prefix + ["apply-to",input,hist_receipt]).run()
  hpoint["startTimeUnixNano"] = Json("1544712660300000000")
  hpoint["timeUnixNano"] = Json("1544712660600000000")
  @fs.write_file(input[:],histogram_source.stringify())
  let hist_next = dir + "/histogram-next.json"
  @shell.Cmd(moon,prefix + ["apply-to",input,hist_next,hist_receipt]).run()
  let hist_output = @fs.read_file(hist_next[:]).text()
  if !hist_output.contains("\"bucketCounts\":[\"2\",\"2\"]") || !hist_output.contains("\"count\":\"4\"") { fail("histogram replay lost samples") }
  let mixed_source = @json.parse(@fs.read_file("examples/upstream-metrics.json").text())
  guard mixed_source is {"resourceMetrics":[{"scopeMetrics":[Object(mscope)],..}],..} && mscope.get("metrics") is Some(Array([counter,gauge,histogram,..])) && counter is {"sum":{"dataPoints":[Object(cp)],..},..} && histogram is {"histogram":{"dataPoints":[Object(hp)],..},..} else { fail("missing mixed fixture") }
  cp["startTimeUnixNano"] = Json("1544712660000000000")
  hp["startTimeUnixNano"] = Json("1544712660000000000")
  mscope["metrics"] = Json::array([counter,gauge,histogram])
  @fs.write_file(input[:],mixed_source.stringify())
  let mixed = @shell.Cmd(moon,prefix + [input]).output()
  if mixed.exit_code() != 0 { fail(mixed.stderr()) }
  guard @json.parse(mixed.stdout()) is {"request":{"resourceMetrics":[{"scopeMetrics":[{"metrics":Array(mixed_metrics),..}],..}],..},..} else { fail("mixed output") }
  if mixed_metrics.length() != 3 || mixed_metrics[1] != gauge { fail("Gauge changed or disappeared") }
  let mixed_receipt = dir + "/mixed-receipt.json"
  @fs.write_file(mixed_receipt[:],mixed.stdout())
  let exported = dir + "/exported.json"
  let exported_result = @shell.Cmd(moon,prefix + ["export",mixed_receipt,exported]).output()
  if exported_result.exit_code() != 0 || !exported_result.stdout().is_empty() { fail("OTLP export failed: " + exported_result.stderr()) }
  guard @json.parse(mixed.stdout()) is {"request":mixed_request,..} else { fail("mixed receipt") }
  if @json.parse(@fs.read_file(exported[:]).text()) != mixed_request { fail("export changed request content") }
  let repeated_export = @shell.Cmd(moon,prefix + ["export",mixed_receipt,exported]).output()
  if repeated_export.exit_code() != 2 || @json.parse(@fs.read_file(exported[:]).text()) != mixed_request { fail("export overwrote an existing file") }
  let inspected = @shell.Cmd(moon,prefix + ["inspect",mixed_receipt]).output()
  if inspected.exit_code() != 0 || !inspected.stdout().contains("\"series\":2") { fail("receipt state inspection failed") }
  @shell.Cmd(moon,["run","checks/protocol.mbtx","--",exported]).run()
  let session_receipt = dir + "/session-receipt.json"
  let session_export = dir + "/session-otlp.json"
  @shell.Cmd(moon,prefix + ["replay-to","examples/session.json",session_receipt]).run()
  @shell.Cmd(moon,prefix + ["export",session_receipt,session_export]).run()
  let session = @fs.read_file(session_export[:]).text()
  if !session.contains("\"asDouble\":7.5") || !session.contains("\"count\":\"4\"") || !session.contains("\"asDouble\":11") { fail("documented session output is wrong") }
  @shell.Cmd(moon,["run","checks/protocol.mbtx","--",session_export]).run()
  let exact_source = @json.parse(first_request.stringify())
  guard exact_source is {"resourceMetrics":[{"scopeMetrics":[{"metrics":[{"sum":{"dataPoints":[Object(exact_point)],..},..}],..}],..}],..} else { fail("exact integer fixture") }
  exact_point["asInt"] = Json("9007199254740993")
  @fs.write_file(input[:],exact_source.stringify())
  let exact_receipt = dir + "/exact-receipt.json"
  let exact_export = dir + "/exact-otlp.json"
  @shell.Cmd(moon,prefix + ["apply-to",input,exact_receipt]).run()
  @shell.Cmd(moon,prefix + ["export",exact_receipt,exact_export]).run()
  if !@fs.read_file(exact_export[:]).text().contains("\"asInt\":\"9007199254740993\"") { fail("large Int64 changed during export") }
  @shell.Cmd(moon,["run","checks/protocol.mbtx","--",exact_export]).run()
  println("OTLP fixture profile, retry and checkpoint recovery passed (" + target + ")")
}
