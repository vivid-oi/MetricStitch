----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----
async fn main {
  let args = @env.args()
  let moon = if args.length() > 1 { args[1] } else { "moon" }
  let target = if args.length() > 2 { args[2] } else { "wasm" }
  let dir = @fs.tmpdir(prefix="metricstitch-")
  defer {
    for file in @fs.readdir(dir[:]) { @fs.remove((dir + "/" + file)[:]) }
    @fs.rmdir(dir[:])
  }
  let prefix = ["run","--target",target,"cli","--"]
  let original = @shell.Cmd(moon,prefix + ["examples/upstream-metrics.json"]).output()
  if original.exit_code() != 2 || !original.stdout().is_empty() { fail("unsupported official example was silently converted") }
  let source = @json.parse(@fs.read_file("examples/upstream-metrics.json").text())
  guard source is {"resourceMetrics":Array([Object(resource)]),..} && resource.get("scopeMetrics") is Some(Array([Object(scope)])) && scope.get("metrics") is Some(Array([Object(metric),..])) && metric.get("sum") is Some(Object(sum)) && sum.get("dataPoints") is Some(Array([Object(point)])) else { fail("upstream fixture shape changed") }
  ignore(point.remove("asDouble"))
  point["asInt"] = Json("5")
  point["startTimeUnixNano"] = Json("1544712660000000000")
  scope["metrics"] = Json::array([Json::object(metric)])
  let input = dir + "/input.json"
  let checkpoint = dir + "/checkpoint.json"
  let receipt = dir + "/first receipt.json"
  @fs.write_file(input[:],source.stringify())
  let first = @shell.Cmd(moon,prefix + [input]).output()
  if first.exit_code() != 0 { fail(first.stderr()) }
  let installed = @shell.Cmd(moon,prefix + ["apply-to",input,receipt]).output()
  if installed.exit_code() != 0 || !installed.stdout().is_empty() || @fs.read_file(receipt[:]).text() != first.stdout() { fail("receipt publication failed") }
  let overwritten = @shell.Cmd(moon,prefix + ["apply-to",input,receipt]).output()
  if overwritten.exit_code() != 2 || @fs.read_file(receipt[:]).text() != first.stdout() { fail("existing receipt was overwritten") }
  let original_input = @fs.read_file(input[:]).text()
  let input_alias = @shell.Cmd(moon,prefix + ["apply-to",input,input]).output()
  if input_alias.exit_code() != 2 || @fs.read_file(input[:]).text() != original_input { fail("input file was overwritten") }
  guard @json.parse(first.stdout()) is {"checkpoint":saved,"request":result,..} else { fail("invalid receipt") }
  if !result.stringify().contains("\"aggregationTemporality\":2") { fail("not cumulative") }
  @fs.write_file(checkpoint[:],saved.stringify())
  let retry = @shell.Cmd(moon,prefix + [input,checkpoint]).output()
  if retry.exit_code() != 0 || !retry.stdout().contains("\"duplicates\":1") { fail("retry duplicated the count") }
  point["startTimeUnixNano"] = Json("1544712660300000000")
  point["timeUnixNano"] = Json("1544712660600000000")
  point["asInt"] = Json("7")
  @fs.write_file(input[:],source.stringify())
  let second = @shell.Cmd(moon,prefix + [input,checkpoint]).output()
  if second.exit_code() != 0 || !second.stdout().contains("\"asInt\":\"12\"") { fail("restored sum is wrong: " + second.stderr()) }
  let next_receipt = dir + "/next receipt.json"
  let resumed_file = @shell.Cmd(moon,prefix + ["apply-to",input,next_receipt,receipt]).output()
  if resumed_file.exit_code() != 0 || @fs.read_file(next_receipt[:]).text() != second.stdout() { fail("whole-receipt resume failed") }
  ignore(point.remove("asInt"))
  point["asDouble"] = Json(1.25)
  @fs.write_file(input[:],source.stringify())
  let floating = @shell.Cmd(moon,prefix + [input]).output()
  if floating.exit_code() != 0 || !floating.stdout().contains("\"asDouble\":1.25") { fail("Double point did not convert") }
  let switched = @shell.Cmd(moon,prefix + [input,checkpoint]).output()
  if switched.exit_code() != 2 || !switched.stdout().is_empty() { fail("numeric kind switch was accepted") }
  @fs.write_file(input[:],"{\"resourceMetrics\":[],\"unknown\":true}")
  let bad = @shell.Cmd(moon,prefix + [input,checkpoint]).output()
  if bad.exit_code() != 2 || !bad.stdout().is_empty() || @fs.read_file(checkpoint[:]).text() != saved.stringify() { fail("rejected input damaged a checkpoint") }
  let refused_file = dir + "/refused.json"
  let refused = @shell.Cmd(moon,prefix + ["apply-to",input,refused_file,receipt]).output()
  if refused.exit_code() != 2 || @fs.exists(refused_file[:]) { fail("invalid batch published a receipt") }
  @fs.write_file(input[:],"{}")
  let malformed_receipt = @shell.Cmd(moon,prefix + ["apply-to","examples/upstream-metrics.json",refused_file,input]).output()
  if malformed_receipt.exit_code() != 2 || !malformed_receipt.stderr().contains("previous receipt") || @fs.exists(refused_file[:]) { fail("malformed resume receipt was accepted") }
  for name in @fs.readdir(dir[:]) {
    if name.has_suffix(".pending") { fail("failed publication left a temporary receipt") }
  }
  let histogram_source = @json.parse(@fs.read_file("examples/upstream-metrics.json").text())
  guard histogram_source is {"resourceMetrics":[{"scopeMetrics":[Object(hscope)],..}],..} && hscope.get("metrics") is Some(Array([_,_,Object(hmetric),..])) && hmetric.get("histogram") is Some({"dataPoints":[Object(hpoint)],..}) else { fail("missing upstream histogram") }
  hscope["metrics"] = Json::array([Json::object(hmetric)])
  hpoint["startTimeUnixNano"] = Json("1544712660000000000")
  @fs.write_file(input[:],histogram_source.stringify())
  let hist_receipt = dir + "/histogram.json"
  @shell.Cmd(moon,prefix + ["apply-to",input,hist_receipt]).run()
  hpoint["startTimeUnixNano"] = Json("1544712660300000000")
  hpoint["timeUnixNano"] = Json("1544712660600000000")
  @fs.write_file(input[:],histogram_source.stringify())
  let hist_next = dir + "/histogram-next.json"
  @shell.Cmd(moon,prefix + ["apply-to",input,hist_next,hist_receipt]).run()
  let hist_output = @fs.read_file(hist_next[:]).text()
  if !hist_output.contains("\"bucketCounts\":[\"2\",\"2\"]") || !hist_output.contains("\"count\":\"4\"") { fail("histogram replay lost samples") }
  println("OTLP fixture profile, retry and checkpoint recovery passed (" + target + ")")
}
